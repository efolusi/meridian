      "content": "<!-- @dsCard group=\"Blocks\" viewport=\"1024x460\" name=\"500 page\" subtitle=\"Server-error page with request id and retry\" -->\n<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><link rel=\"stylesheet\" href=\"../styles.css\">\n<script src=\"https://unpkg.com/react@18.3.1/umd/react.production.min.js\" integrity=\"sha384-DGyLxAyjq0f9SPpVevD6IgztCFlnMF6oW/XQGmfe+IsZ8TqEiDrcHkMLKI6fiB/Z\" crossorigin=\"anonymous\"></script>\n<script src=\"https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js\" integrity=\"sha384-gTGxhz21lVGYNMcdJOyq01Edg0jhn/c22nsx0kyqP0TxaV5WVdsSH1fSDUf5YJj1\" crossorigin=\"anonymous\"></script>\n<script src=\"https://unpkg.com/@babel/standalone@7.29.0/babel.min.js\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"></script>\n<script src=\"../_ds_bundle.js\"></script>\n<style>@media(max-width:600px){.bk-sec{padding:48px 18px!important}.bk-h1{font-size:30px!important}}</style>\n</head><body style=\"background:var(--surface-page)\">\n<div id=\"root\"></div>\n<script type=\"text/babel\">\n\nconst { Button, CopyField, Icon } = window.EfolusiDesignSystem_4ffc3d;\nfunction Block() {\n  const requestId = 'req_8f3c1d92a4';\n  return (\n    <section className=\"bk-sec\" style={{ padding: '72px 48px', textAlign: 'center' }}>\n      <div style={{ width: 40, height: 40, margin: '0 auto', display: 'flex', alignItems: 'center', justifyContent: 'center', borderRadius: 'var(--radius-md)', background: 'var(--surface-sunken)', color: 'var(--text-secondary)' }}>\n        <Icon name=\"triangle-alert\" size={20} />\n      </div>\n      <div style={{ fontFamily: 'var(--font-mono)', fontSize: 13, color: 'var(--text-muted)', marginTop: 14 }}>500</div>\n      <h1 className=\"bk-h1\" style={{ fontFamily: 'var(--font-display)', fontSize: 40, fontWeight: 680, letterSpacing: '-0.02em', margin: '12px 0 0' }}>Something broke on our side.</h1>\n      <p style={{ fontSize: 15, lineHeight: 1.6, color: 'var(--text-secondary)', margin: '12px auto 0', maxWidth: 440 }}>Nothing you did caused this, and nothing you saved was lost. The request below is already in our logs.</p>\n      <div style={{ display: 'flex', gap: 8, justifyContent: 'center', margin: '24px auto 0', maxWidth: 380 }}>\n        <Button onClick={() => window.location.reload()}>Try again</Button>\n        <Button variant=\"secondary\" onClick={() => { window.location.href = '/'; }}>Back to home</Button>\n      </div>\n      <div style={{ margin: '24px auto 0', maxWidth: 320, textAlign: 'left' }}>\n        <CopyField label=\"Request ID\" value={requestId} />\n      </div>\n      <div style={{ marginTop: 14, fontSize: 13, color: 'var(--text-muted)' }}>\n        Still stuck? <a href=\"#\" style={{ fontWeight: 600 }}>Check status</a> or <a href=\"#\" style={{ fontWeight: 600 }}>contact support</a> with that ID.\n      </div>\n    </section>\n  );\n}\nReactDOM.createRoot(document.getElementById('root')).render(<Block />);\n</script></body></html>\n"
    }
  ],
  "categories": [
    "blocks"
  ],
