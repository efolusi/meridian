# Response headers for meridian.efolusi.com, read by Workers static assets.
# This file is the only source of them. Cloudflare joins the values when two
# rules set the same header on one path, so the Cache-Control rules below never
# overlap (tests/worker-deploy.test.mjs).

# Every response.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  X-Meridian-Environment: production

# Logos, favicon, social image and icons: a week, so a replaced file without a
# ?v= query still propagates on its own.
/assets/:file
  Cache-Control: public, max-age=604800

/assets/icons/*
  Cache-Control: public, max-age=604800

# Self-hosted fonts keep stable filenames: a year, but not immutable, so a face
# replaced in place still reaches a returning visitor. Any origin may load them:
# the faces are OFL, and a page linking styles.css from this host otherwise
# falls back to system fonts.
/assets/fonts/*
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

# The registry is public JSON for external tools.
/registry.json
  Access-Control-Allow-Origin: *

/site/registry.json
  Access-Control-Allow-Origin: *

/site/registry/*
  Access-Control-Allow-Origin: *

# Never let the bundle, styles, tokens or the site runtime go stale: support.js
# re-fetches location.href on *.dc.html pages, so a cached copy renders an old
# release.
/_ds_bundle.js
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/landing.css
  Cache-Control: no-cache

/tokens/*
  Cache-Control: no-cache

# Plain scripts for other Efolusi sites: module scripts load cross-origin only with CORS.
/browser/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/site/*
  Cache-Control: no-cache

# The root docs llms.txt points agents to, as UTF-8 text instead of a download.
/LICENSE
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/README.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/ARCHITECTURE.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/CHANGELOG.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/CONTRIBUTING.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/SECURITY.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

# The release marker the deploy checks must never be cached.
/meridian-release.txt
  Cache-Control: no-store, max-age=0
